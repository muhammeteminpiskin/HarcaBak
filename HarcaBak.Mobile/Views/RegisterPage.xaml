<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HarcaBak.Mobile.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Kayıt Ol">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="14">

            <Label
                Text="Hesap Oluştur"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Entry
                x:Name="NameEntry"
                Placeholder="Ad Soyad" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Şifre"
                IsPassword="True" />

            <Entry
                x:Name="ConfirmPasswordEntry"
                Placeholder="Şifre tekrar"
                IsPassword="True" />

            <Button
                Text="Kayıt Ol"
                Clicked="OnRegisterClicked" />

            <Button
                Text="Giriş Sayfasına Dön"
                Clicked="OnBackToLoginClicked" />

            <Label
                x:Name="MessageLabel"
                Text=""
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>