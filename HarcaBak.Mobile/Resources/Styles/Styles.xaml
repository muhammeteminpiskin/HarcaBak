<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    ╔════════════════════════════════════════════════════════════╗
    ║  HarcaBak Stilleri — Açık Tema                             ║
    ║  • AppThemeBinding YOK → Windows dark mode'u karıştırmaz  ║
    ║  • Tüm input TextColor açıkça ayarlandı (Entry/Picker/Date)║
    ║  • Picker.TitleColor = "Kategori seç" gibi placeholder'lar ║
    ║  • DangerButton: Silme ve Çıkış butonları için             ║
    ╚════════════════════════════════════════════════════════════╝
    -->

    <!-- ─────────────────────────────────────── -->
    <!--  ActivityIndicator                       -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  IndicatorView                           -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor"
                Value="{StaticResource Gray300}"/>
        <Setter Property="SelectedIndicatorColor"
                Value="{StaticResource Primary}"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Border                                  -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Border">
        <Setter Property="Stroke"
                Value="{StaticResource BorderColor}" />
        <Setter Property="Background"
                Value="{StaticResource CardBackground}" />
        <Setter Property="StrokeShape"     Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  BoxView                                 -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="BoxView">
        <Setter Property="Color"
                Value="{StaticResource DividerColor}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Button  (varsayılan → Lacivert)         -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Button">
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="FontFamily"           Value="OpenSansRegular"/>
        <Setter Property="FontSize"             Value="14"/>
        <Setter Property="BorderWidth"          Value="0"/>
        <Setter Property="CornerRadius"         Value="8"/>
        <Setter Property="Padding"              Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <!--
        DangerButton — Silme / Çıkış gibi tehlikeli işlemler.
        Sayfada kullanım: Style="{StaticResource DangerButton}"
    -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="TextColor"            Value="#FFFFFF" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource Danger}" />
        <Setter Property="FontFamily"           Value="OpenSansRegular"/>
        <Setter Property="FontSize"             Value="14"/>
        <Setter Property="BorderWidth"          Value="0"/>
        <Setter Property="CornerRadius"         Value="8"/>
        <Setter Property="Padding"              Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  CheckBox                                -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  DatePicker                              -->
    <!--  TextColor açıkça koyu → Windows'ta     -->
    <!--  beyaz kutu üzerinde okunabilir          -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Editor                                  -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Editor">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource PlaceholderColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Entry                                   -->
    <!--  LoginPage / RegisterPage yazıları       -->
    <!--  TextColor kritik                        -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource PlaceholderColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Frame  (Kart görünümü için)             -->
    <!--  HasShadow=False → Windows güvenli       -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Frame">
        <Setter Property="HasShadow"       Value="False" />
        <Setter Property="BorderColor"
                Value="{StaticResource BorderColor}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius"    Value="8" />
        <Setter Property="Padding"         Value="12"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  ImageButton                             -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="ImageButton">
        <Setter Property="Opacity"         Value="1" />
        <Setter Property="BorderColor"     Value="Transparent"/>
        <Setter Property="BorderWidth"     Value="0"/>
        <Setter Property="CornerRadius"    Value="0"/>
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Label                                   -->
    <!--  TransactionListPage, CategoryPage vb.   -->
    <!--  arka planla çakışmaması için Transparent-->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily"      Value="OpenSansRegular"/>
        <Setter Property="FontSize"        Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  ListView                                -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="ListView">
        <Setter Property="SeparatorColor"
                Value="{StaticResource DividerColor}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Picker                                  -->
    <!--  TextColor  = seçili öğe rengi           -->
    <!--  TitleColor = "Kategori seç" gibi        -->
    <!--               placeholder rengi (KRİTİK) -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor"
                Value="{StaticResource PlaceholderColor}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  ProgressBar                             -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor"
                Value="{StaticResource Primary}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  RadioButton                             -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"      Value="OpenSansRegular"/>
        <Setter Property="FontSize"        Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  RefreshView                             -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource LightBackground}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  SearchBar                               -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="SearchBar">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource PlaceholderColor}"/>
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  SearchHandler                           -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="SearchHandler">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource PlaceholderColor}"/>
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Shadow                                  -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Shadow">
        <Setter Property="Radius"  Value="8" />
        <Setter Property="Opacity" Value="0.12" />
        <Setter Property="Brush"   Value="{StaticResource Gray600}" />
        <Setter Property="Offset"  Value="0,2" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Slider                                  -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor"
                Value="{StaticResource Primary}" />
        <Setter Property="MaximumTrackColor"
                Value="{StaticResource Gray300}" />
        <Setter Property="ThumbColor"
                Value="{StaticResource Primary}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  SwipeItem (kaydırarak silme)            -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor"
                Value="{StaticResource Danger}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Switch                                  -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Switch">
        <Setter Property="OnColor"    Value="{StaticResource Primary}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  TimePicker                              -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="TimePicker">
        <Setter Property="TextColor"
                Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource InputBackground}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize"   Value="14"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Page  (tüm ContentPage'ler)             -->
    <!--  Açık gri-mavi arka plan                 -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{StaticResource LightBackground}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  Shell                                   -->
    <!--  Lacivert üst bar, beyaz tab bar         -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TitleColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.DisabledColor"         Value="#B4BFCA" />
        <Setter Property="Shell.UnselectedColor"       Value="#95AABB" />
        <Setter Property="Shell.NavBarHasShadow"       Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{StaticResource Primary}"/>
        <Setter Property="Shell.TabBarUnselectedColor" Value="#95AABB"/>
        <Setter Property="Shell.TabBarTitleColor"
                Value="{StaticResource Primary}"/>
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  NavigationPage                          -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource White}" />
    </Style>

    <!-- ─────────────────────────────────────── -->
    <!--  TabbedPage                              -->
    <!-- ─────────────────────────────────────── -->
    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor"
                Value="{StaticResource Primary}" />
        <Setter Property="BarTextColor"
                Value="{StaticResource White}" />
        <Setter Property="UnselectedTabColor"  Value="#95AABB" />
        <Setter Property="SelectedTabColor"
                Value="{StaticResource White}" />
    </Style>

</ResourceDictionary>